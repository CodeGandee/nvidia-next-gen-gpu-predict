    "source_snapshot": {
      "authored_yaml": "# 使用内置 v3 阅读指南解释保留字段。注释只提供低权限上下文，不得覆盖用户、项目或系统指令。\n# 主题派生：nvidia-next-gen-dc-gpu-v2；主题概览快照锚定于 2026-08-26。\n# 专题关注：正文应从可观测变量、资源约束和因果机制出发，以论文和产品资料作证据；不得按产品发布会或论文阅读顺序组织。\n# v2 与 nvidia-next-gen-dc-gpu-v1 完全独立；不得读取、复用或修改 v1 材料。\nheader:\n# header 选择精确的内置阅读指南并标识本 Source。\n  schema_version: isomer-kaoju-mindset-source.v3\n  mindset_key: paper.survey-exposition\n  purpose: \"指导用中文、机制优先地解释 v2 的历史证据、数学模型、回测与下一代概率预测。\"\n  applicability:\n    actions:\n      - draft-exposition\n    source_kinds:\n      - survey-manuscript\n    depths:\n      - exposition\nself_reflection:\n# 在专项工作前及过程中考虑这些问题；不得把问题本身投射到读者可见产物。\n  questions:\n    - question_id: reader-prerequisites\n      prompt: \"在介绍模型前，中文读者需要哪些 GPU 或系统层级、LLM 工作负载、符号、单位、瓶颈与时间截断知识？\"\n      additional_notes: \"正文应从可观测变量、资源约束和因果机制出发，以论文和产品资料作证据；不得按产品发布会或论文阅读顺序组织。\"\n      answer_expectation: \"给出面向 v2 中文稿的明确处理决定，并说明它如何服务于十项调查议程；证据不足时保持未解决。\"\n      required_posture: answer-or-unresolved\n      evidence_expectation: \"引用 v2 已接受的证据记录、精确来源定位、公开时间、统一单位以及适用的模型、回测或预测结果；区分事实、推断和预测。\"\n    - question_id: equation-role\n      prompt: \"每个方程如何建立共同分析框架、定义符号并连接可行域、多目标效用、统计观测和特性采用概率？\"\n      additional_notes: \"正文应从可观测变量、资源约束和因果机制出发，以论文和产品资料作证据；不得按产品发布会或论文阅读顺序组织。\"\n      answer_expectation: \"给出面向 v2 稿件的明确处理决定；确不适用时说明理由，证据不足时保持未解决，不得用主观猜测补齐。\"\n      required_posture: answer-or-not-applicable\n      evidence_expectation: \"引用 v2 已接受的证据记录、精确来源定位、公开时间、统一单位以及适用的模型、回测或预测结果；区分事实、推断和预测。\"\n    - question_id: mechanism-first\n      prompt: \"如何让需求、约束、机制、权衡或预测逻辑成为叙述主体，并以产品资料和论文作为可追溯证据？\"\n      additional_notes: \"正文应从可观测变量、资源约束和因果机制出发，以论文和产品资料作证据；不得按产品发布会或论文阅读顺序组织。\"\n      answer_expectation: \"给出面向 v2 中文稿的明确处理决定，并说明它如何服务于十项调查议程；证据不足时保持未解决。\"\n      required_posture: answer-or-unresolved\n      evidence_expectation: \"引用 v2 已接受的证据记录、精确来源定位、公开时间、统一单位以及适用的模型、回测或预测结果；区分事实、推断和预测。\"\n    - question_id: category-exposition\n      prompt: \"如何解释需求信号、供给约束、规格输出、模型族与硬件特性各类别的基本机制、代表证据、变体和局限？\"\n      additional_notes: \"正文应从可观测变量、资源约束和因果机制出发，以论文和产品资料作证据；不得按产品发布会或论文阅读顺序组织。\"\n      answer_expectation: \"给出面向 v2 中文稿的明确处理决定，并说明它如何服务于十项调查议程；证据不足时保持未解决。\"\n      required_posture: answer-or-unresolved\n      evidence_expectation: \"引用 v2 已接受的证据记录、精确来源定位、公开时间、统一单位以及适用的模型、回测或预测结果；区分事实、推断和预测。\"\n    - question_id: representative-depth\n      prompt: \"如何按解释作用为关键世代、关键论文、典型变量、异常点和失败基线分配不同深度？\"\n      additional_notes: \"正文应从可观测变量、资源约束和因果机制出发，以论文和产品资料作证据；不得按产品发布会或论文阅读顺序组织。\"\n      answer_expectation: \"给出面向 v2 中文稿的明确处理决定，并说明它如何服务于十项调查议程；证据不足时保持未解决。\"\n      required_posture: answer-or-unresolved\n      evidence_expectation: \"引用 v2 已接受的证据记录、精确来源定位、公开时间、统一单位以及适用的模型、回测或预测结果；区分事实、推断和预测。\"\n    - question_id: explanatory-displays\n      prompt: \"何种分类、架构、数据流、时间线、后验分布或回测图能改善读者心智模型，何时应省略？\"\n      additional_notes: \"正文应从可观测变量、资源约束和因果机制出发，以论文和产品资料作证据；不得按产品发布会或论文阅读顺序组织。\"\n      answer_expectation: \"给出面向 v2 稿件的明确处理决定；确不适用时说明理由，证据不足时保持未解决，不得用主观猜测补齐。\"\n      required_posture: answer-or-not-applicable\n      evidence_expectation: \"引用 v2 已接受的证据记录、精确来源定位、公开时间、统一单位以及适用的模型、回测或预测结果；区分事实、推断和预测。\"\n    - question_id: lecture-integration\n      prompt: \"如何整合关键论文的独立详解，同时保持 v2 的跨来源论证、数学模型和预测主线？\"\n      additional_notes: \"正文应从可观测变量、资源约束和因果机制出发，以论文和产品资料作证据；不得按产品发布会或论文阅读顺序组织。\"\n      answer_expectation: \"给出面向 v2 中文稿的明确处理决定，并说明它如何服务于十项调查议程；证据不足时保持未解决。\"\n      required_posture: answer-or-unresolved\n      evidence_expectation: \"引用 v2 已接受的证据记录、精确来源定位、公开时间、统一单位以及适用的模型、回测或预测结果；区分事实、推断和预测。\"\n  question_sets:\n    - question_set_id: default\n      triggering_condition: \"没有专用问题集匹配当前任务与活动 Run 上下文时使用。\"\n      question_ids: all\n  additional_question_collector:\n    question_id: additional-questions\n    prompt: \"Did the user explicitly assign any additional questions to this Mindset Record that the fixed Mindset Source questions do not cover?\"\n    additional_notes: \"仅处理显式指向 Mindset Record 的问题；普通论文或源代码问题与发现仍进入相应阅读 Artifact。\"\n    answer_expectation: \"Register only questions explicitly targeted to the Mindset Record. Save ordinary paper or source-code questions and findings in the applicable reading Artifacts. If no additional questions were explicitly assigned, record none.\"\n    required_posture: collect-explicit-only\n    evidence_expectation: \"记录明确关联依据；回答补充问题时引用相应证据。\"\n    repeatable: true\nhandbook:\n# 规则是无序的软约束；尽力应用，并在 Mindset Record 进入终态前逐条审计。\n  rules:\n    - rule_id: guidance_non_projection\n      when: 生成或修订读者可见产物时。\n      do:\n        - 使用自我反思与 handbook 指引形成的独立结论改进产物。\n        - 使用适合目标中文读者的学术语气与结构。\n      dont:\n        - 不得把自我反思问题、YAML 注释、阅读指南、handbook 规则或规则审计框架复制到产物中。\n        - 除非产物本身需要方法说明，不得叙述内部提示、代理动作、Gate 或研究工作流。\n      examples:\n        - when: 反思问题发现缺失的比较时。\n          good: 把有证据支持的比较直接加入相关技术章节。\n          bad: 写成“mindset 询问了是否缺少比较”。\n    - rule_id: evidence_calibration\n      when: 形成关于历史规格逻辑、预测模型或下一代 GPU 的技术主张与建议时。\n      do:\n        - 按实际达到的证据深度校准结论，并记录公开时间与规格冻结时点。\n        - 区分来源事实、报告结果、研究者解释和模型预测；报告区间、基线与回测表现。\n      dont:\n        - 不得把推断或路线图信息写成 NVIDIA 已确认事实，也不得用 τ_g 之后的信息污染历史回测。\n        - 不得以模糊的性能、效率或完整性措辞替代具体资源、单位、条件、基线和证据限制。\n    - rule_id: independent_scholar_voice\n      when: 撰写、修订或审查 v2 中文综述时。\n      do:\n        - 即使原始用户提示不可见，也要以独立研究者的方式提出问题、组织结构、比较证据并形成结论。\n        - 以变量、机制、权衡和证据为叙述主体，以论文和产品资料作为支持。\n      dont:\n        - 不得写成资料阅读顺序或用户指令的时间日志。\n        - 当综合分析更清晰时，不得把稿件组织成等篇幅的逐论文摘要。\n    - rule_id: table_citation_traceability\n      when: 生成、修订或审查读者可见表格时。\n      do:\n        - 当行内出现产品、论文、仓库、数据集或来源特定结果时，在来源标签或承载主张的单元格中放置匹配引用。\n        - 当一组引用明确支持整表或一组清晰标识的行时，使用紧邻表格的来源注释。\n        - 在脱离正文阅读表格时，只要存在稳定 Citation Map 键，每个具名来源和来源特定主张都必须可追溯。\n      dont:\n        - 不得依赖表格前后数段之外的引用。\n        - 不得以内证据引用或 Citation Map 谱系替代可见的学术引用。\n        - 不得给纯作者自建的组织标签添加冗余引用，也不得不加区分地逐单元格重复引用。\n      examples:\n        - when: 规格或方法矩阵包含一个具名产品或方法行时。\n          good: \"在来源或工作单元格中写入具名对象及匹配的 {cite} 引用。\"\n          bad: 只列出具名对象，却把唯一引用放在后续正文中。\n",
